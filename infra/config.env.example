# =============================================================================
# Configuração da infraestrutura do DEM — copie para infra/config.env
# (infra/config.env está no .gitignore: NÃO versione dados da sua conta)
# =============================================================================

# Conta e região AWS
AWS_ACCOUNT_ID=123456789012
AWS_REGION=sa-east-1
# Perfil do AWS CLI configurado com "aws configure --profile dem" (opcional)
AWS_PROFILE=dem

# Domínio público da aplicação (A record -> IP estático da instância)
DEM_DOMAIN=diario.exemplo.com.br
# Domínio registrado (zona DNS) ao qual DEM_DOMAIN pertence
DEM_ZONA_DNS=exemplo.com.br
# E-mail para alertas (Budgets, alarmes) e para o Let's Encrypt
ALERTA_EMAIL=voce@exemplo.com
# Remetente dos e-mails transacionais (domínio verificado no SES)
MAIL_FROM_ADDRESS=nao-responda@diario.exemplo.com.br

# Repositório GitHub (dono/nome) autorizado a assumir a role via OIDC
GITHUB_REPO=joaobschweikart/pwa-sistema-escolar

# Modo da instância:
#   dedicado      -> cria a instância Lightsail «dem-prod» (opção da modelagem)
#   compartilhado -> usa uma instância existente (DEM_INSTANCIA), atrás do nginx de borda dela
DEM_MODO=dedicado

# Nomes dos recursos (iguais aos da modelagem)
DEM_INSTANCIA=dem-prod
DEM_IP_ESTATICO=dem-prod-ip
DEM_ECR_REPO=dem-app
# Buckets têm nome global: se "dem-backups" já existir em outra conta, use um sufixo
DEM_BUCKET=dem-backups
DEM_SSM_PARAM_PATH=/dem/prod

# Orçamento mensal (USD) para o alarme do AWS Budgets
ORCAMENTO_USD=20
# Retenção dos backups no bucket (dias)
BACKUP_RETENCAO_DIAS=30
