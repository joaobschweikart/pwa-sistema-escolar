{
  "agent": {
    "metrics_collection_interval": 300,
    "run_as_user": "root",
    "region": "sa-east-1"
  },
  "metrics": {
    "namespace": "DEM/Producao",
    "append_dimensions": { "InstanceId": "dem-prod" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/dem/containers/*.log", "log_group_name": "/dem/prod/containers", "log_stream_name": "dem-prod", "retention_in_days": 30 },
          { "file_path": "/var/log/dem-deploy.log", "log_group_name": "/dem/prod/deploy", "log_stream_name": "dem-prod", "retention_in_days": 90 },
          { "file_path": "/var/log/dem-backup.log", "log_group_name": "/dem/prod/backup", "log_stream_name": "dem-prod", "retention_in_days": 90 }
        ]
      }
    }
  }
}
