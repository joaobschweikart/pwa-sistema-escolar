{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "ssm.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "__AWS_ACCOUNT_ID__" },
        "ArnEquals": { "aws:SourceArn": "arn:aws:ssm:__AWS_REGION__:__AWS_ACCOUNT_ID__:*" }
      }
    }
  ]
}
