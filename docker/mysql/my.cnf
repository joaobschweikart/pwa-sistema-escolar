# MySQL 8.4 do DEM — enxuto: divide a instância de 2 GB com outra aplicação.
# Volume do DEM (1 município) cabe folgado em 128 MB de buffer pool.
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '-03:00'
skip-name-resolve
performance_schema = OFF
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_redo_log_capacity = 64M
max_connections = 30
thread_cache_size = 4
table_open_cache = 400
table_definition_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
key_buffer_size = 8M
sort_buffer_size = 1M
join_buffer_size = 1M
