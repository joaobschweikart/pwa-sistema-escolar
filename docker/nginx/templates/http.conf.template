# Modo HTTP: desenvolvimento local e primeira subida em produção (antes do certificado).
server {
    listen 80 default_server;
    server_name ${DEM_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/dem-app.conf;
}
